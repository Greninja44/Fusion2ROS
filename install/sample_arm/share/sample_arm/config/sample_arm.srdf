<?xml version="1.0"?>
<robot name="sample_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="forearm" />
  </group>
  <group_state name="home" group="arm">
    <joint name="shoulder_joint" value="0.0" />
    <joint name="elbow_joint" value="0.0" />
  </group_state>
  <disable_collisions link1="base_link" link2="upper_arm" reason="Adjacent" />
  <disable_collisions link1="upper_arm" link2="forearm" reason="Adjacent" />
</robot>
