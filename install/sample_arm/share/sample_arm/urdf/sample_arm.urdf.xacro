<?xml version="1.0"?>
<robot name="sample_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.08" length="0.05" />
      </geometry>
      <material name="base_grey">
        <color rgba="0.4 0.4 0.4 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="0.08" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.004" iyy="0.004" izz="0.006" ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.05 0.05 0.3" />
      </geometry>
      <material name="arm_blue">
        <color rgba="0.2 0.4 0.9 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.05 0.05 0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.15" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.006" iyy="0.006" izz="0.0007" ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.04 0.04 0.25" />
      </geometry>
      <material name="arm_orange">
        <color rgba="0.9 0.5 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <box size="0.04 0.04 0.25" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.125" rpy="0 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.002" iyy="0.002" izz="0.0003" ixy="0.0" ixz="0.0" iyz="0.0" />
    </inertial>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link" />
    <child link="upper_arm" />
    <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0" />
    <axis xyz="0.0 0.0 1.0" />
    <limit lower="-3.14159265" upper="3.14159265" effort="20.0" velocity="2.0" />
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0" />
    <axis xyz="0.0 1.0 0.0" />
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="2.0" />
  </joint>
<ros2_control name="sample_arm" type="system">
  <hardware>
    <plugin>mock_components/GenericSystem</plugin>
  </hardware>
  <joint name="shoulder_joint">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
    <state_interface name="effort" />
  </joint>
  <joint name="elbow_joint">
    <command_interface name="position" />
    <state_interface name="position" />
    <state_interface name="velocity" />
    <state_interface name="effort" />
  </joint>
</ros2_control></robot>
